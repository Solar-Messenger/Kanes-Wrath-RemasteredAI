<?xml version="1.0" encoding="utf-8" ?>
<AssetDeclaration xmlns="uri:ea.com:eala:asset" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Tags></Tags>
  <Includes></Includes>

  <!--If opponent is low on funds cripple his economy-->
  <AIStrategicStateDefinition
		id="GDIResourceSqueeze"
		UnitUpgradeMultiplier="0.0">
    <Heuristic>
		<TimerHeuristic StartTime="60s" EndTime="-1s"/>
		<PathToTargetHeuristic PathExists="true"/>
    </Heuristic>
    <TargetHeuristic TargetHeuristic="EconomyKillHeuristic" TargetType="PrimaryTarget"/>
    <Tactic Tactic="FlankAttack" TargetType="PrimaryTarget">
      <TeamTemplate MinUnits="5" MaxUnits="5" IncludeKindOf="CAN_ATTACK" ExcludeKindOf="BOMBER_AIRCRAFT" AlwaysRelease="false" AlwaysRecruit="false"/>
    </Tactic>
    <UnitModifierByName UnitName="GDIPitbull" UnitPreferenceOffensiveModifier="300%" UnitPreferenceDefensiveModifier="300%"/>
  </AIStrategicStateDefinition>

  <!--If opponent is nearly matched in forces, take out his production capacity-->
  <AIStrategicStateDefinition
		id="GDIProductionHalt"
		UnitUpgradeMultiplier="0.0">
    <Heuristic>
		<TimerHeuristic StartTime="60s" EndTime="-1s" />
		<PathToTargetHeuristic PathExists="true"/>
    </Heuristic>
    <TargetHeuristic TargetHeuristic="ProductionKillHeuristic" TargetType="PrimaryTarget"/>
    <Tactic Tactic="FlankAttack" TargetType="PrimaryTarget">
      <TeamTemplate MinUnits="5" MaxUnits="5" IncludeKindOf="CAN_ATTACK" ExcludeKindOf="BOMBER_AIRCRAFT" AlwaysRelease="false" AlwaysRecruit="false"/>
    </Tactic>
  </AIStrategicStateDefinition>

  <!--If opponent is near power threshold, take his power offline-->
  <AIStrategicStateDefinition
		id="GDIPowerCut"
		UnitUpgradeMultiplier="0.0">
    <Heuristic>
		<TimerHeuristic StartTime="60s" EndTime="-1s" />
		<PathToTargetHeuristic PathExists="true"/>
    </Heuristic>
    <TargetHeuristic TargetHeuristic="PowerKillHeuristic" TargetType="PrimaryTarget"/>
    <Tactic Tactic="FlankAttack" TargetType="PrimaryTarget">
      <TeamTemplate MinUnits="5" MaxUnits="5" IncludeKindOf="CAN_ATTACK" ExcludeKindOf="AIRCRAFT" AlwaysRelease="false" AlwaysRecruit="false"/>
    </Tactic>
	  <UnitModifierByName UnitName="GDIPredator" UnitPreferenceOffensiveModifier="250%" UnitPreferenceDefensiveModifier="250%"/>
	  <UnitModifierByName UnitName="GDIPitbull" UnitPreferenceOffensiveModifier="250%" UnitPreferenceDefensiveModifier="250%"/>
  </AIStrategicStateDefinition>

	<AIStrategicStateDefinition
		id="GDIGuerillaOverwhelm"
		UnitUpgradeMultiplier="0.0">
		<Heuristic>
			<PathToTargetHeuristic PathExists="true"/>
		</Heuristic>
		<TargetHeuristic TargetHeuristic="ClosestStructureHeuristic" TargetType="FocusedTarget"/>
		<Tactic Tactic="FlankAttack" TargetType="FocusedTarget">
			<TeamTemplate MinUnits="20" MaxUnits="20" IncludeKindOf="CAN_ATTACK" ExcludeKindOf="BOMBER_AIRCRAFT" AlwaysRelease="false" AlwaysRecruit="false"/>
		</Tactic>
	</AIStrategicStateDefinition>

  <!--If opponent is turtling, siege his base with many "mini" siege groups-->
  <AIStrategicStateDefinition
		id="GDIMiniSiege"
		UnitUpgradeMultiplier="0.0">
    <Heuristic>
      <PathToTargetHeuristic PathExists="true"/>
      <LateGameHeuristic/>
      <SiegeThresholdHeuristic SiegeMode="true" Threshold="1.5"/>
    </Heuristic>
    <TargetHeuristic TargetHeuristic="ClosestStructureHeuristic" TargetType="PrimaryTarget"/>
    <Tactic Tactic="SimpleSiege" TargetType="PrimaryTarget">
      <TeamTemplate MinUnits="1" MaxUnits="1" IncludeKindOf="CAN_ATTACK" ExcludeKindOf="AIRCRAFT" AlwaysRelease="false" AlwaysRecruit="false">
        <CreateUnits UnitName="GDIJuggernaught"/>
      </TeamTemplate>
      <TeamTemplate MinUnits="3" MaxUnits="3" IncludeKindOf="CAN_ATTACK" ExcludeKindOf="AIRCRAFT" AlwaysRelease="false" AlwaysRecruit="false"/>
    </Tactic>
  </AIStrategicStateDefinition>

  <!--If opponent's base is undefended sneak an engineer in to capture key structures-->
  <AIStrategicStateDefinition
		id="GDIEngineer"
		UnitUpgradeMultiplier="0.0">
    <Heuristic>
		<TimerHeuristic StartTime="60s" EndTime="-1s"/>
		<PathToTargetHeuristic PathExists="true"/>
    </Heuristic>
    <TargetHeuristic TargetHeuristic="EngineerHeuristic" TargetType="Engineer"/>
    <Tactic Tactic="DefenseAvoidanceAttack" TargetType="Engineer">
      <TeamTemplate MinUnits="1" MaxUnits="1" IncludeKindOf="" ExcludeKindOf="AIRCRAFT" AlwaysRelease="false" AlwaysRecruit="false">
        <CreateUnits UnitName="GDIEngineer"/>
      </TeamTemplate>
    </Tactic>
  </AIStrategicStateDefinition>

  <!--Airstrike targets undefended by AA-->
  <AIStrategicStateDefinition
		id="GDIGuerillaAirHarassment"
		UnitUpgradeMultiplier="0.0">
    <Heuristic>
      <ConstantHeuristic Weight="1.0"/>
    </Heuristic>
    <TargetHeuristic TargetHeuristic="SafestToAirUnitHeuristic" TargetType="AssaultAirstrike"/>
    <TargetHeuristic TargetHeuristic="SafestToAirPowerPlantHeuristic" TargetType="AssaultAirstrike"/>
    <Tactic Tactic="DefenseAvoidanceAttack" TargetType="AssaultAirstrike">
      <TeamTemplate MinUnits="8" MaxUnits="8" IncludeKindOf="CAN_ATTACK AIRCRAFT ASSAULT_AIRCRAFT" ExcludeKindOf="" AlwaysRelease="false" AlwaysRecruit="false"/>
    </Tactic>
  </AIStrategicStateDefinition>

  <AIStrategicStateDefinition
		id="GDIGuerillaBombingRuns"
		UnitUpgradeMultiplier="0.0">
    <Heuristic>
      <LateGameHeuristic/>
    </Heuristic>
    <TargetHeuristic TargetHeuristic="SafestToAirStructureHeuristic" TargetType="BombingAirstrike"/>
    <Tactic Tactic="FlankAttack" TargetType="BombingAirstrike">
      <TeamTemplate MinUnits="4" MaxUnits="4" IncludeKindOf="CAN_ATTACK AIRCRAFT BOMBER_AIRCRAFT" ExcludeKindOf="" AlwaysRelease="false" AlwaysRecruit="false">
        <CreateUnits MinUnits="4" MaxUnits="4" UnitName="GDIFireHawk"/>
      </TeamTemplate>
    </Tactic>
  </AIStrategicStateDefinition>

	<AIStrategicStateDefinition
    id="GDIGuerillaSpotters"
    UnitUpgradeMultiplier="0.0">
		<Heuristic>
			<PathToTargetHeuristic PathExists="true"/>
			<LateGameHeuristic/>
		</Heuristic>
		<TargetHeuristic TargetHeuristic="SafestToGroundStructureHeuristic" TargetType="SecondaryTarget"/>
		<Tactic Tactic="DefenseAvoidanceAttack" TargetType="SecondaryTarget">
			<TeamTemplate MinUnits="1" MaxUnits="1" IncludeKindOf="CAN_ATTACK" ExcludeKindOf="AIRCRAFT" AlwaysRelease="false" AlwaysRecruit="false">
				<CreateUnits MinUnits="1" MaxUnits="1" UnitName="GDISniperSquad"/>
			</TeamTemplate>
		</Tactic>
	</AIStrategicStateDefinition>

  <!--Constantly pester opponent with small attacks on random targets -->
  <AIStrategicStateDefinition
		id="GDIDiversion"
		UnitUpgradeMultiplier="0.0">
    <Heuristic>
		<TimerHeuristic StartTime="60s" EndTime="-1s" />
		<PathToTargetHeuristic PathExists="true"/>
    </Heuristic>
    <TargetHeuristic TargetHeuristic="SafestToGroundStructureHeuristic" TargetType="Diversion"/>
    <Tactic Tactic="DefenseAvoidanceAttack" TargetType="Diversion">
      <TeamTemplate MinUnits="4" MaxUnits="4" IncludeKindOf="CAN_ATTACK" ExcludeKindOf="AIRCRAFT" AlwaysRelease="false" AlwaysRecruit="false"/>
    </Tactic>
	  <UnitModifierByName UnitName="GDIPredator" UnitPreferenceOffensiveModifier="250%" UnitPreferenceDefensiveModifier="250%"/>
	  <UnitModifierByName UnitName="GDIAPC" UnitPreferenceOffensiveModifier="250%" UnitPreferenceDefensiveModifier="250%"/>
  </AIStrategicStateDefinition>

	<AIStrategicStateDefinition
		  id="GDIGuerillaGarrisonEpicUnit"
		  UnitUpgradeMultiplier="0.0">
		<Heuristic>
			<ConstantHeuristic Weight="900.0" />
		</Heuristic>
		<TargetHeuristic TargetHeuristic="GarrisonEpicUnitHeuristic" TargetType="Garrison"/>
		<Tactic Tactic="GarrisonBuilding" TargetType="Garrison">
			<TeamTemplate MinUnits="4" MaxUnits="4" IncludeKindOf="INFANTRY" ExcludeKindOf="VEHICLE AIRCRAFT UNIQUE_UNIT" AlwaysRelease="false" AlwaysRecruit="false"/>
		</Tactic>
		<UnitModifierByName UnitName="GDIZoneTrooperSquad" UnitPreferenceOffensiveModifier="300%" UnitPreferenceDefensiveModifier="300%"/>
		<UnitModifierByName UnitName="GDIMissileSoldierSquad" UnitPreferenceOffensiveModifier="300%" UnitPreferenceDefensiveModifier="300%"/>
	</AIStrategicStateDefinition>

  <AIBudgetStateDefinition
    id="GDIGuerillaTechByTimeBudget">
    <Heuristic>
      <ConstantHeuristic Weight="0.8"/>
      <OpeningMoveHeuristic Complete="true"/>
      <TimerHeuristic StartTime="90s" EndTime="-1s"/>
      <IntervalHeuristic IntervalTime="60s" ActiveTime="20s"/>
      <IntervalHeuristic IntervalTime="5s" ActiveTime="5s"/>
    </Heuristic>
    <Budget>
      <AccountShare Account="INVESTMENT" Percent="0%"/>
      <AccountShare Account="SPECIAL_OPERATIONS" Percent="0%"/>
      <AccountShare Account="PRODUCTION" Percent="0%"/>
      <AccountShare Account="DEFENSE" Percent="0%"/>
      <AccountShare Account="TECHNOLOGY" Percent="90%"/>
      <AccountShare Account="SLUSH_FUND" Percent="10%"/>
    </Budget>
  </AIBudgetStateDefinition>

  <AIBudgetStateDefinition
    id="GDIGuerillaTechByTimeBudget_EASY">
    <Heuristic>
      <ConstantHeuristic Weight="0.8"/>
      <OpeningMoveHeuristic Complete="true"/>
      <IntervalHeuristic IntervalTime="670s" ActiveTime="20s"/>
      <IntervalHeuristic IntervalTime="7s" ActiveTime="3s"/>
    </Heuristic>
    <Budget>
      <AccountShare Account="INVESTMENT" Percent="0%"/>
      <AccountShare Account="SPECIAL_OPERATIONS" Percent="0%"/>
      <AccountShare Account="PRODUCTION" Percent="0%"/>
      <AccountShare Account="DEFENSE" Percent="0%"/>
      <AccountShare Account="TECHNOLOGY" Percent="90%"/>
      <AccountShare Account="SLUSH_FUND" Percent="10%"/>
    </Budget>
  </AIBudgetStateDefinition>

</AssetDeclaration>
