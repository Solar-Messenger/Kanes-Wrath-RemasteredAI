	<!--Budgets-->
	
	<!--If decisive victory is imminent, dedicate to units and support powers and close off the game-->
	
	<AIBudgetStateDefinition
		  id="CleanupBudget">
		<Heuristic>
			<ConstantHeuristic Weight="0.99"/> 
			<OpeningMoveHeuristic Complete="true"/>
			<ProductionAdvantageHeuristic />
			<FocusedThresholdHeuristic />
			<SiegeThresholdHeuristic SiegeMode="false" Threshold="0.5" />
			<EnemyNearbyHeuristic Distance="2000.0" EnemyNearby="false" />
			<PathToTargetHeuristic PathExists="true" />
		</Heuristic>
		<Budget>
			<AccountShare Account="INVESTMENT" Percent="0%"/>
			<AccountShare Account="SPECIAL_OPERATIONS" Percent="30%"/>
			<AccountShare Account="PRODUCTION" Percent="60%"/>
			<AccountShare Account="DEFENSE" Percent="0%"/>
			<AccountShare Account="TECHNOLOGY" Percent="0%"/>
			<AccountShare Account="SLUSH_FUND" Percent="10%"/>
		</Budget>
	</AIBudgetStateDefinition>
	
